config clamd 'clamd'
	option clamd_config_file '/etc/clamav/clamd.conf'
	option LogTime '1'
	option LogSyslog '1'
	option LogFacility 'LOG_LOCAL6'
	option LogVerbose '0'
	option MaxDirectoryRecursion '15'
	option FollowDirectorySymlinks '0'
	option FollowFileSymlinks '0'
	option DetectPUA '0'
	option ScanPE '1'
	option ScanELF '1'
	option DetectBrokenExecutables '0'
	option AlertBrokenExecutables '0'
	option ScanOLE2 '1'
	option ScanPDF '1'
	option ScanSWF '1'
	option ScanMail '1'
	option ScanPartialMessages '0'
	option ScanArchive '1'
	option BlockEncrypted '0'
	option AlertEncrypted '0'
	option StreamMinPort '1024'
	option StreamMaxPort '2048'
	option ReadTimeout '120'
	option CommandReadTimeout '10'
	option MaxThreads '2'
	option SelfCheck '600'
	option MaxFileSize '25M'
	option TCPAddr '127.0.0.1'
	option TCPSocket '3310'
	option User 'nobody'
	option ExitOnOOM '0'
	option DisableCertCheck '0'
	option DatabaseDirectory '/usr/share/clamav'
	option TemporaryDirectory '/tmp'
	option LocalSocket '/var/run/clamav/clamd.sock'

config milter 'milter'
	option milter_config_file '/etc/clamav/clamav-milter.conf'
	option Foreground '0'
	option PidFile '/var/run/clamav/clamav-milter.pid'
	option User 'nobody'
	option MilterSocketGroup 'clamav'
	option ReadTimeout '120'
	option OnClean 'Accept'
	option OnInfected 'Quarantine'
	option OnFail 'Defer'
	option AddHeader 'Replace'
	option LogTime '1'
	option LogVerbose '0'
	option Debug '0'
	option LogSyslog '1'
	option LogFacility 'LOG_LOCAL6'
	option LogInfected '1'
	option LogClean '0'
	option MaxFileSize '25M'
	option SupportMultipleRecipients '0'
	option RejectMsg ''
	option VirusAction ''
	option TemporaryDirectory '/tmp'
	option MilterSocket '/var/run/clamav/clamav-milter.sock'
	option ClamdSocket 'unix:/var/run/clamav/clamd.sock'
	option FixStaleSocket '1'

config freshclam 'freshclam'
	option freshclam_config_file '/etc/clamav/freshclam.conf'
	option LogTime '1'
	option LogVerbose '0'
	option Debug '0'
	option LogSyslog '1'
	option LogFacility 'LOG_LOCAL6'
	option Foreground '0'
	option PidFile '/var/run/clamav/freshclam.pid'
	option NotifyClamd '1'
	option DatabaseOwner 'nobody'
	option DatabaseDirectory '/usr/share/clamav'
	option DNSDatabaseInfo 'current.cvd.clamav.net'
	option DatabaseMirror 'database.clamav.net'
	option DatabaseCustomURL ''
	option PrivateMirror ''
	option ScriptedUpdates '1'
	option CompressLocalDatabase '0'
	option ConnectTimeout '30'
	option ReceiveTimeout '60'
	option Checks '12'
	option TestDatabases '1'
	option Bytecode '1'
